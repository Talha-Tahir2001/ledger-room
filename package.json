{
  "name": "ledger-room",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "gate": "tsx scripts/gate.ts",
    "fixtures": "tsx scripts/gen-fixtures.ts",
    "ingest:verify": "tsx scripts/verify-ingest.ts",
    "eval": "tsx scripts/eval.ts",
    "eval:cache": "tsx scripts/cache-report.ts",
    "chase:eval": "tsx --env-file=.env scripts/chase-eval.ts",
    "results:export": "tsx scripts/export-results.ts",
    "history": "tsx scripts/gen-history.ts",
    "contrast:fix": "tsx scripts/contrast-fix.ts",
    "verify:secrets": "tsx --env-file=.env scripts/verify-secrets.ts",
    "verify:atlas": "tsx --env-file=.env scripts/verify-atlas.ts",
    "probe:tabpfn": "tsx --env-file=.env scripts/probe-tabpfn.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@sentry/nextjs": "^11.8.0",
    "@tabler/icons-react": "^3.49.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "mongodb": "^7.7.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.22.0",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
